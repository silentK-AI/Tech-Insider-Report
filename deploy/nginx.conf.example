# 科技内参 - Nginx 反代配置示例
# 安装: sudo cp nginx.conf.example /etc/nginx/conf.d/tech-neican.conf
# 修改 server_name 后执行: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name _;              # 有域名后改成你的域名, 如 tech.example.com

    gzip on;
    gzip_types text/plain text/css application/json application/javascript;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # 可选: 对纯静态资源加浏览器缓存 (资讯页 30s 即可, 别太长)
    # location ~* \.(css|js|png|jpg|svg|ico)$ {
    #     proxy_pass http://127.0.0.1:8080;
    #     expires 1h;
    # }
}

